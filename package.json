{
  "name": "treasure-pop-wonderlands",
  "version": "0.0.0-prd02",
  "private": true,
  "type": "module",
  "description": "Treasure Pop — Wonderlands technical foundation shell (PRD-02).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
